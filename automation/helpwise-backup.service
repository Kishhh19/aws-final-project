[Unit]
Description=HelpWise encrypted MongoDB backup to S3
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/helpwise-backup.sh
User=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=append:/var/log/helpwise-backup.log
StandardError=append:/var/log/helpwise-backup.log

[Install]
WantedBy=multi-user.target
